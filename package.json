{
  "name": "legalapp-desktop",
  "version": "1.0.0",
  "description": "Windows Desktop Prototype",
  "main": "dist/main.js",
  "scripts": {
    "start": "concurrently \"npm run start:renderer\" \"npm run start:electron\"",
    "start:renderer": "webpack serve --config webpack.renderer.config.js",
    "start:electron": "wait-on http://localhost:3000 && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "package": "electron-builder"
  },
  "keywords": ["electron", "windows", "desktop"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "css-loader": "^6.9.0",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "dependencies": {
    "@fluentui/react": "^8.118.2",
    "@fluentui/react-components": "^9.47.2",
    "@fluentui/react-icons": "^2.0.228",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.legalapp.desktop",
    "productName": "LegalApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    }
  }
}
